{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": "../..",
  "mainEntryPointFilePath": "<projectFolder>/dist/runtime/resolver-public.d.ts",
  "apiReport": { "enabled": true, "reportFolder": "<projectFolder>/api-reports", "reportTempFolder": "<projectFolder>/temp/api", "reportFileName": "runtime-resolver.api.md" },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "messages": { "compilerMessageReporting": { "default": { "logLevel": "warning" } }, "extractorMessageReporting": { "default": { "logLevel": "warning" } } }
}
